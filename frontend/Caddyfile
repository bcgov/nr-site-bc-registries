# Listen only on high ports (3000, 3001, 3003).
{
	metrics
	auto_https off
	admin 0.0.0.0:3003
	order coraza_waf first
}
:3000 {
	log {
		output stdout
		format console
		level {$LOG_LEVEL}
	}

	# Enable Coraza WAF
	coraza_waf {
		directives `
		Include /etc/caddy/coraza.conf
		`
	}

	root * /srv
	encode zstd gzip

	route {
		# Proxy requests to the backend API
		reverse_proxy /api* {$BACKEND_URL} {
			header_up Host {http.reverse_proxy.upstream.hostport}
			header_up X-Real-IP {remote_host}
		}
		# Static assets (css/js/images/fonts) served directly from /srv
		file_server {
			pass_thru
		}
		# Everything else - server-rendered pages (/, /address-search, ...)
		# and report/PDF generation (/bc-registry*) - is handled by the
		# local Nest BFF (puppeteer/chromium).
		reverse_proxy localhost:3002
	}
	header {
		-Server
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1;mode=block"
		Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self' https://*.gov.bc.ca;
			script-src 'self' 'unsafe-inline' https://*.gov.bc.ca https://code.jquery.com https://cdnjs.cloudflare.com https://stackpath.bootstrapcdn.com https://cdn.datatables.net https://unpkg.com;
			style-src 'self' https://fonts.googleapis.com https://use.fontawesome.com https://unpkg.com https://cdnjs.cloudflare.com https://cdn.datatables.net 'unsafe-inline';
			font-src 'self' https://fonts.gstatic.com;
			img-src 'self' data: https://fonts.googleapis.com https://www.w3.org https://*.gov.bc.ca https://*.tile.openstreetmap.org https://cdnjs.cloudflare.com;
			frame-ancestors 'self';
			form-action 'self';
			block-all-mixed-content;
			connect-src 'self' https://*.gov.bc.ca wss://*.gov.bc.ca;"
		Referrer-Policy "same-origin"
		Permissions-Policy "fullscreen=(self), camera=(), microphone=()"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
	}
}
:3001 {
	handle /health {
		respond "OK"
	}
}
